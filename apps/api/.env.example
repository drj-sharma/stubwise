# Copy to .env for local development. Never commit .env.

PORT=4000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection string. Leave empty in development to use an embedded
# database stored in apps/api/.pgdata (no Docker or Postgres needed).
# With `docker compose up -d db` use:
# DATABASE_URL=postgres://stubwise:stubwise@127.0.0.1:5433/stubwise
DATABASE_URL=

# Requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=120
