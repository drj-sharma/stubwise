# Copy to .env for local development. Never commit .env. Every value here is a placeholder.
#   uv run --env-file .env uvicorn --factory app.main:create_app --port 4000

# development | test | production. Production refuses to start without the values marked (required).
APP_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# (required in production) Empty in development uses SQLite in ./stubwise.db.
# DATABASE_URL=postgresql://stubwise:stubwise@127.0.0.1:5433/stubwise
DATABASE_URL=

# (required in production) Signs access tokens; at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in development generates a new one each start (access tokens then stop working on restart).
AUTH_JWT_SECRET=

# (one of the two is required in production) Comma-separated values accepted as the ID token's `aud`.
# Google: the OAuth client IDs of the iOS / Android / web apps.
GOOGLE_CLIENT_IDS=
# Apple: the app's bundle ID (and a Services ID if there is a web sign-in).
APPLE_CLIENT_IDS=

REFRESH_TOKEN_DAYS=60

# Browser origins allowed to call the API. Empty (the default) disables CORS; the mobile app needs none.
CORS_ALLOWED_ORIGINS=
# /docs and /openapi.json. Default: on in development, off in production.
# DOCS_ENABLED=true

# Requests per minute: every client address / sign-in routes per address / changes per user.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
WRITE_RATE_LIMIT_PER_MINUTE=120

# --- Tax form e-filing through TaxBandits: PARKED. Leave off. ---
# The routes exist only when FILING_ENABLED=true AND all three credentials are set.
FILING_ENABLED=false
TAXBANDITS_ENV=sandbox
TAXBANDITS_CLIENT_ID=
TAXBANDITS_CLIENT_SECRET=
TAXBANDITS_USER_TOKEN=
FILING_RATE_LIMIT_PER_MINUTE=10
