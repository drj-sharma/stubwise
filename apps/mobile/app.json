{
  "expo": {
    "name": "CrewStub",
    "slug": "crewstub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "crewstub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.crewstub.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "CrewStub uses a photo you choose as your business logo on pay stubs."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.crewstub.app",
      "adaptiveIcon": {
        "backgroundColor": "#EDEDEE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEDEE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0F1014",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "CrewStub uses a photo you choose as your business logo on pay stubs.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-mail-composer"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://jnmxfbddllmxvwcljkrdxc6r.187.127.166.249.sslip.io"
    }
  }
}
