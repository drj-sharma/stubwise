{
  "expo": {
    "name": "CrewStub",
    "slug": "crewstub",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "crewstub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.crewstub.app",
      "supportsTablet": true,
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "CrewStub uses a photo you choose as your business logo on pay stubs."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.crewstub.app",
      "adaptiveIcon": {
        "backgroundColor": "#EDEDEE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEDEE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0F1014",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "CrewStub uses a photo you choose as your business logo on pay stubs.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#3F3D9E"
        }
      ],
      "expo-secure-store",
      "expo-mail-composer",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.825852853732-sb6ouggo07f358njodnn0qdl1o9lr493"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://jnmxfbddllmxvwcljkrdxc6r.187.127.166.249.sslip.io",
      "googleIosClientId": "825852853732-sb6ouggo07f358njodnn0qdl1o9lr493.apps.googleusercontent.com"
    }
  }
}
