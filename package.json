    "api": "pnpm --filter @stubwise/api dev"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  }
}
